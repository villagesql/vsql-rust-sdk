# Tests aggregate VDFs: agg_sum reimplements SUM over ints via clear/accumulate/result.
# clear resets the accumulator at the start of each group, accumulate folds each row,
# result emits the group's total. Proves aggregate VDFs work end-to-end.

INSTALL EXTENSION vsql_agg_sum;

CREATE TABLE t (grp INT, val INT);
INSERT INTO t VALUES (1, 10), (1, 20), (2, 100), (2, 200), (2, 300);

--echo # Whole-table aggregate: 10+20+100+200+300 = 630, matching built-in SUM.
SELECT vsql_agg_sum.agg_sum(val) AS mine, SUM(val) AS builtin FROM t;

--echo # GROUP BY: clear must reset per group. Group 1 = 30, group 2 = 600.
--echo # If clear fired only once, group 2 would carry group 1 -> 630, and this fails.
SELECT grp, vsql_agg_sum.agg_sum(val) AS mine, SUM(val) AS builtin FROM t GROUP BY grp ORDER BY grp;

--echo # Mixed NULLs: agg_sum must skip NULLs like built-in SUM (10+20=30).
CREATE TABLE n (val INT);
INSERT INTO n VALUES (10), (NULL), (20);
SELECT vsql_agg_sum.agg_sum(val) as MINE, SUM(val) AS builtin FROM n;

--echo # Empty set: built-in SUM returns NULL over zero rows. agg_sum should match.
SELECT vsql_agg_sum.agg_sum(val) AS mine, SUM(val) AS builtin FROM n WHERE 1=0;

--echo # All-NULL group: built-in SUM returns NULL when every value is NULL.
DELETE FROM n;
INSERT INTO n VALUES (NULL), (NULL);
SELECT vsql_agg_sum.agg_sum(val) AS mine, SUM(val) AS builtin FROM n;

DROP TABLE n; 

DROP TABLE t;

UNINSTALL EXTENSION vsql_agg_sum;
