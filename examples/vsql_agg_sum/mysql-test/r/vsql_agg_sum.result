INSTALL EXTENSION vsql_agg_sum;
CREATE TABLE t (grp INT, val INT);
INSERT INTO t VALUES (1, 10), (1, 20), (2, 100), (2, 200), (2, 300);
# Whole-table aggregate: 10+20+100+200+300 = 630, matching built-in SUM.
SELECT vsql_agg_sum.agg_sum(val) AS mine, SUM(val) AS builtin FROM t;
mine	builtin
630	630
# GROUP BY: clear must reset per group. Group 1 = 30, group 2 = 600.
# If clear fired only once, group 2 would carry group 1 -> 630, and this fails.
SELECT grp, vsql_agg_sum.agg_sum(val) AS mine, SUM(val) AS builtin FROM t GROUP BY grp ORDER BY grp;
grp	mine	builtin
1	30	30
2	600	600
# Mixed NULLs: agg_sum must skip NULLs like built-in SUM (10+20=30).
CREATE TABLE n (val INT);
INSERT INTO n VALUES (10), (NULL), (20);
SELECT vsql_agg_sum.agg_sum(val) as MINE, SUM(val) AS builtin FROM n;
MINE	builtin
30	30
# Empty set: built-in SUM returns NULL over zero rows. agg_sum should match.
SELECT vsql_agg_sum.agg_sum(val) AS mine, SUM(val) AS builtin FROM n WHERE 1=0;
mine	builtin
NULL	NULL
# All-NULL group: built-in SUM returns NULL when every value is NULL.
DELETE FROM n;
INSERT INTO n VALUES (NULL), (NULL);
SELECT vsql_agg_sum.agg_sum(val) AS mine, SUM(val) AS builtin FROM n;
mine	builtin
NULL	NULL
DROP TABLE n;
DROP TABLE t;
UNINSTALL EXTENSION vsql_agg_sum;
