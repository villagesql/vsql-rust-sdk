INSTALL EXTENSION vsql_rot13;
# Basic ASCII rotation
SELECT rot13('Hello, World!');
rot13('Hello, World!')
Uryyb, Jbeyq!
# rot13 is its own inverse
SELECT rot13(rot13('Hello, World!'));
rot13(rot13('Hello, World!'))
Hello, World!
# Uppercase and lowercase handled independently
SELECT rot13('ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz');
rot13('ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz')
NOPQRSTUVWXYZABCDEFGHIJKLMnopqrstuvwxyzabcdefghijklm
# Numbers and punctuation pass through unchanged
SELECT rot13('abc123!@#');
rot13('abc123!@#')
nop123!@#
# Empty string
SELECT rot13('');
rot13('')

# NULL input produces NULL output
SELECT rot13(NULL);
rot13(NULL)
NULL
# Works over a table column
CREATE TABLE t1 (s VARCHAR(100));
INSERT INTO t1 VALUES ('Hello'), ('World'), (NULL), ('rot13 test 123');
SELECT rot13(s) FROM t1 ORDER BY s;
rot13(s)
NULL
Uryyb
ebg13 grfg 123
Jbeyq
DROP TABLE t1;
# Bytes that aren't valid UTF-8 fail the statement instead of crashing the server
SELECT rot13(_binary 0xff);
ERROR HY000: VDF error in function 'rot13': argument 1 is not valid UTF-8 (invalid byte at offset 0); convert it with CONVERT(... USING utf8mb4)
CREATE TABLE t2 (s VARCHAR(10) CHARACTER SET latin1);
INSERT INTO t2 VALUES (_latin1 0x636166E9);
SELECT rot13(s) FROM t2;
ERROR HY000: VDF error in function 'rot13': argument 1 is not valid UTF-8 (invalid byte at offset 3); convert it with CONVERT(... USING utf8mb4)
# Converting to utf8mb4 first makes the same value work
SELECT rot13(CONVERT(s USING utf8mb4)) FROM t2;
rot13(CONVERT(s USING utf8mb4))
pnsé
DROP TABLE t2;
# Valid multi-byte UTF-8 still passes through
SELECT rot13('café ✓ 日本');
rot13('café ✓ 日本')
pnsé ✓ 日本
# The server is still up
SELECT 1;
1
1
UNINSTALL EXTENSION vsql_rot13;
